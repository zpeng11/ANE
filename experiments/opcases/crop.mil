program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1, 3, 32, 32]> x) {
        tensor<int32, [2]> ch = const()[name = string("ch"), val = tensor<int32, [2]>([2, 2])];
        tensor<int32, [2]> cw = const()[name = string("cw"), val = tensor<int32, [2]>([2, 2])];
