program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1, 3, 32, 32]> x) {
        fp16 ep = const()[name = string("ep"), val = fp16(0x1.0c6f7a0b5ed8dp-20)];
        tensor<fp16, [3]> W = const()[name = string("W"), val = tensor<fp16, [3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
        tensor<fp16, [3]> W2 = const()[name = string("W2"), val = tensor<fp16, [3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(192)))];
        tensor<fp16, [3]> W3 = const()[name = string("W3"), val = tensor<fp16, [3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(320)))];
        tensor<fp16, [3]> W4 = const()[name = string("W4"), val = tensor<fp16, [3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(448)))];
        tensor<fp16, [1, 3, 32, 32]> out = instance_norm(x = x, gamma = W3, beta = W4, epsilon = ep)[name = string("out")];
    } -> (out);
}
