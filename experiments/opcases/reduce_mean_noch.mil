program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1, 32, 32, 3]> x) {
        tensor<int32, [3]> ax = const()[name = string("ax"), val = tensor<int32, [3]>([0, 1, 2])];
        bool kd = const()[name = string("kd"), val = bool(true)];
        tensor<fp16, [1, 1, 1, 3]> out = reduce_mean(x = x, axes = ax, keep_dims = kd)[name = string("out")];
    } -> (out);
}
