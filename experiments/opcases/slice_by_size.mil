program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1, 3, 32, 32]> x) {
        tensor<int32, [4]> bg = const()[name = string("bg"), val = tensor<int32, [4]>([0, 0, 0, 0])];
        tensor<int32, [4]> sz = const()[name = string("sz"), val = tensor<int32, [4]>([1, 3, 16, 16])];
        tensor<fp16, [1, 3, 16, 16]> out = slice_by_size(x = x, begin = bg, size = sz)[name = string("out")];
    } -> (out);
}
