program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1, 3, 8, 8]> x) {
        fp32 sh = const()[name = string("sh"), val = fp32(2.0)];
        fp32 sw = const()[name = string("sw"), val = fp32(2.0)];
        tensor<fp16, [1, 3, 16, 16]> out = upsample_bilinear(x = x, scale_factor_height = sh, scale_factor_width = sw)[name = string("out")];
    } -> (out);
}
